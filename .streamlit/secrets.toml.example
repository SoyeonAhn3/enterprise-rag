# Configure these only in the server's Secrets settings. Never commit real keys.
ANTHROPIC_API_KEY = ""
ANTHROPIC_MODEL = "claude-sonnet-5-5"
ANTHROPIC_MAX_TOKENS = 2048
API_TIMEOUT_SECONDS = 30
EMBEDDING_PROVIDER = "fastembed"
EMBEDDING_MODEL = "intfloat/multilingual-e5-small"
EMBEDDING_DIMENSIONS = 384
# The public model downloads once to this writable server cache.
EMBEDDING_CACHE_DIR = "data/embedding_models"
EMBEDDING_LOCAL_FILES_ONLY = false
RAG_CHUNK_SIZE = 800
RAG_CHUNK_OVERLAP = 120
RAG_TOP_K = 3
# Opt-in Phase 6 mode: "pages". The deployed baseline remains "chunks".
RAG_RETRIEVAL_MODE = "chunks"
RAG_CONTEXT_MAX_CHARS = 6000
LANGSMITH_TRACING = false
LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "enterprise-rag-mvp"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
SESSION_QUESTION_LIMIT = 10
