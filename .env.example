# Claude is for answer generation. Never commit .env or API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2048
API_TIMEOUT_SECONDS=30

# Local multilingual embeddings: no API key, first run downloads the model.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=data/embedding_models
EMBEDDING_LOCAL_FILES_ONLY=false
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# MVP release keeps k=3; k is not part of the index signature.
RAG_TOP_K=3

# Optional tracing. Missing/failed tracing never prevents RAG answers.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Basic per-session demo limit (not a provider-wide budget control).
SESSION_QUESTION_LIMIT=10
